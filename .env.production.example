APP_NAME="Franconia API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://api.franconia.in
FRONTEND_URL=https://franconia.in,https://www.franconia.in
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_franconia
DB_USERNAME=cpaneluser_franconia
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Configure real SMTP before enabling email features. SMTP alone does not add order emails.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Franconia Fine Fragrances"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STORE_SUPPORT_EMAIL=franconia.finefragrances@outlook.com
STORE_BUSINESS_ADDRESS="Plot No. 5, SR No. 78, Tatya Tope Housing Society 1, Tatya Tope Housing Society Road, Wanowrie, Haveli, Pune, Maharashtra 411040, India"
STORE_GRIEVANCE_OFFICER="Vinita Pise"

STORE_GRIEVANCE_EMAIL=vinitapise@gmail.com
STORE_GRIEVANCE_PHONE="+91 9130498922"

STORE_BACKUP_DIR=/home/u974495265/franconia-private/backups
STORE_MYSQLDUMP_BINARY=mysqldump
